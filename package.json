{
  "name": "pulso-colombia",
  "private": true,
  "version": "0.1.0",
  "description": "Bilingual, privacy-preserving earthquake response map for western Colombia.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jussalcedoga/pulso-colombia.git"
  },
  "bugs": {
    "url": "https://github.com/jussalcedoga/pulso-colombia/issues"
  },
  "homepage": "https://pulso-colombia.juan-sebastian-salcedo-gallo-th.workers.dev",
  "keywords": [
    "cloudflare-workers",
    "colombia",
    "disaster-response",
    "earthquake",
    "humanitarian",
    "satellite-imagery"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply pulso-colombia --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulso-colombia --remote",
    "deploy": "npm run build && wrangler deploy",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "quick-tunnel": "bash scripts/quick-tunnel.sh",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "h3-js": "^4.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  }
}
